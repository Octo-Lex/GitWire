    "submission": {
      "payload": {
        "approvalEvidenceComplete": true,
        "findings": [
          {
            "claim": "After this change, triageIssue logs decision \"skipped\" (with reason \"no labels to apply\" and configUsed containing only auto_label) for issues that now visibly receive a GitHub summary comment and an add-comment managed action, because the decision-log entry derives its decision field solely from label application while auto_comment no longer depends on needs_more_info/duplicate_hint.",
            "confidence": 0.8,
            "description": "The gate change at triageWorker.js:358 makes the comment post for every non-dry-run triaged issue, but the preceding logDecision (L332-L347) still records decision=\"skipped\" whenever labelsToApply.length===0 and its conditions/configUsed omit auto_comment entirely. Per docs/api/decisions.md:3 (\"why every worker acted, skipped, or was blocked\"), an operator filtering decision=skipped will now see entries for issues that received a bot comment. The comment action itself is separately recorded in the managed-actions ledger, so this is an audit-accuracy gap rather than a functional defect; it predates the PR (the needs_more_info path had the same gap) but the change makes it apply to every no-label issue. Recommend adding an auto_comment condition/configUsed field and keying the decision off labels-OR-comment.",
            "evidenceRefs": [
              "changed:packages/web/src/workers/triageWorker.js@HEAD:L332-L347",
              "changed:packages/web/src/workers/triageWorker.js@HEAD:L349-L358",
              "repo-read:docs/api/decisions.md@HEAD:L3-L3",
              "repo-read:packages/web/src/workers/triageWorker.js@HEAD:L384-L392"
            ],
            "severity": "P3"
