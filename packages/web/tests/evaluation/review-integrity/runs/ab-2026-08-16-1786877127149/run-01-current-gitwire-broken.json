      "payload": {
        "findings": [
          {
            "severity": "P3",
            "category": "docs_gap",
            "claim": "Worker job-flow doc still omits the (now unconditional) triage comment step",
            "description": "After this change, every successfully triaged issue with auto_comment enabled (the default per packages/rules/src/schema.js:14) receives a marker-backed summary comment, but docs/workers/triage-worker.md's Job Flow (steps 1-8) lists label application and duplicate detection with no comment-posting step. Pre-existing omission, now more visible since the comment is guaranteed rather than exceptional. Not a contradiction of the config contract (policy-as-code.md:65 'auto_comment: true # Post triage summary comment' is now correctly honored by the code).",
            "affectedPaths": [
              "docs/workers/triage-worker.md",
              "packages/web/src/workers/triageWorker.js"
            ],
